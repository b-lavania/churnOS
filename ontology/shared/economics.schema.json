{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://churnos.local/ontology/shared/economics.schema.json",
  "title": "Economics",
  "type": "object",
  "properties": {
    "primary_metric_usd": { "type": "number" },
    "primary_metric_label": { "type": "string" },
    "currency": { "type": "string", "default": "USD" },
    "breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "amount_usd"],
        "properties": {
          "label": { "type": "string" },
          "amount_usd": { "type": "number" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
